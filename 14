# Enter your code here. Read input from STDIN. Print output to STDOUT
from itertools import combinations

# Read the space-separated string and integer k
s, k = input().split()

# Sort the string to ensure lexicographic order in output
sorted_s = sorted(s)

# Iterate through lengths from 1 to k (inclusive)
for i in range(1, int(k) + 1):
    # Generate all combinations of length i
    for comb in combinations(sorted_s, i):
        # Join the tuple into a string and print
        print(''.join(comb))
